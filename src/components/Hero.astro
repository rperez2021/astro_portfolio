---
---

<section id="hero" class="min-h-screen flex items-center pt-20">
  <div class="mx-auto max-w-5xl px-6 py-24 w-full">
    <div class="max-w-3xl">
      <p class="font-mono text-[var(--color-accent)] text-sm mb-4 tracking-widest uppercase">
        Hello, I'm
      </p>
      <h1 class="text-5xl md:text-7xl font-bold text-[var(--color-text)] leading-tight mb-4">
        Roberto<br />
        <span class="text-[var(--color-muted)]">Perez</span>
      </h1>
      <h2 class="text-xl md:text-2xl font-medium text-[var(--color-muted)] mb-6">
        Web Developer &amp; Software Engineer
      </h2>
      <p class="text-base md:text-lg text-[var(--color-muted)] max-w-2xl leading-relaxed mb-10">
        San Diego-based developer with experience building custom web applications,
        SaaS integrations, and full-stack solutions. Specializing in React, Node,
        TypeScript, and AWS.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[var(--color-accent)] text-white font-medium hover:bg-[var(--color-accent-dim)] transition-colors duration-200"
        >
          View My Work
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-[var(--color-border)] text-[var(--color-text)] font-medium hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all duration-200"
        >
          Get In Touch
        </a>
      </div>
      <div class="flex items-center gap-6 mt-12">
        <a
          href="https://linkedin.com/in/roberto-perez-sd"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors"
          aria-label="LinkedIn"
        >
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://github.com/rperez2021"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors"
          aria-label="GitHub"
        >
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
        <div class="h-px flex-1 bg-[var(--color-border)] max-w-[120px]"></div>
        <span class="font-mono text-xs text-[var(--color-muted)]">San Diego, CA</span>
      </div>
    </div>
  </div>
</section>
