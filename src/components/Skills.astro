---
const skillGroups = [
  {
    category: 'Frontend',
    skills: ['React', 'Vue 3', 'TypeScript', 'JavaScript (ES6+)', 'HTML5', 'CSS3', 'Tailwind CSS', 'Astro'],
  },
  {
    category: 'Backend',
    skills: ['Node.js', 'PHP', 'Laravel', '.NET', 'REST APIs', 'GraphQL'],
  },
  {
    category: 'CMS & E-commerce',
    skills: ['WordPress', 'Elementor', 'Divi', 'Shopify', 'WooCommerce'],
  },
  {
    category: 'Cloud & DevOps',
    skills: ['AWS (Certified)', 'S3', 'EC2', 'Git', 'GitHub', 'CI/CD', 'Docker'],
  },
  {
    category: 'Databases',
    skills: ['MySQL', 'PostgreSQL', 'MongoDB', 'NoSQL'],
  },
  {
    category: 'Other',
    skills: ['SaaS Integration', 'Cross-browser Testing', 'Responsive Design', 'Software Documentation', 'Code Review'],
  },
];
---

<section id="skills" class="py-24 border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-[var(--color-accent)] text-xs tracking-widest uppercase mb-3">Skills</p>
    <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-12">Technologies I work with</h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillGroups.map((group) => (
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 hover:border-[var(--color-accent)]/40 transition-colors duration-300">
          <p class="font-mono text-xs text-[var(--color-accent)] tracking-widest uppercase mb-4">{group.category}</p>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="text-xs text-[var(--color-text)] bg-[var(--color-tag-bg)] border border-[var(--color-border)] px-2.5 py-1.5 rounded-lg">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
      <p class="font-mono text-xs text-[var(--color-accent)] tracking-widest uppercase mb-4">Certifications</p>
      <div class="flex flex-wrap gap-4">
        <div class="flex items-center gap-3 bg-[var(--color-tag-bg)] border border-[var(--color-border)] rounded-lg px-4 py-3">
          <div class="w-8 h-8 rounded bg-[#FF9900]/20 flex items-center justify-center shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FF9900">
              <path d="M13.23 10.56V10c-1.94.02-3.99.39-3.99 2.67 0 1.16.61 1.95 1.63 1.95.76 0 1.43-.47 1.86-1.22.52-.93.5-1.8.5-2.84zM20.05 16.13c-.14.12-.34.13-.5.04C19 15.62 18.67 15.22 18.5 14.6c-.76.78-1.3 1.27-2.3 1.59-.95.3-2.22.43-3.29.02-1.2-.46-2.05-1.44-2.31-2.8-.1-.5-.14-1-.11-1.5.08-1.28.58-2.1 1.36-2.7.72-.56 1.7-.87 2.72-.99.63-.08 1.83-.17 2.57-.4v-.24c0-.48.04-.93-.11-1.27-.2-.47-.61-.7-1.04-.76-.44-.08-.85.05-1.15.27-.33.25-.39.58-.44.89l-2.2-.27c.08-.61.3-1.19.7-1.64.6-.69 1.6-1.06 2.7-1.06 1.13 0 2.32.36 3.05 1.2.37.42.64.99.7 1.59.06.5.05 1.02.05 1.53v3.56c0 .83.09 1.47.33 1.9.14.23.3.44.53.63-.04.05-.77.63-.77.63zM21.8 18.4c-2.15 1.57-5.27 2.4-7.95 2.4-3.75 0-7.13-1.39-9.68-3.69-.2-.18-.02-.43.22-.29 2.76 1.6 6.17 2.56 9.69 2.56 2.38 0 4.99-.49 7.39-1.51.37-.16.67.24.33.53zM22.72 17.37c-.27-.35-1.77-.17-2.45-.08-.2.02-.24-.16-.05-.29 1.2-.84 3.17-.6 3.39-.32.23.29-.06 2.27-1.18 3.22-.17.15-.34.07-.26-.12.25-.63.81-2.06.55-2.41z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-[var(--color-text)]">AWS Certified Cloud Practitioner</p>
            <p class="font-mono text-xs text-[var(--color-muted)]">Amazon Web Services</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
