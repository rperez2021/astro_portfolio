---
---

<section id="about" class="py-24 border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div>
        <p class="font-mono text-[var(--color-accent)] text-xs tracking-widest uppercase mb-3">About</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-6">
          Building things for the web
        </h2>
        <div class="space-y-4 text-[var(--color-muted)] leading-relaxed">
          <p>
            I'm a web developer and software engineer based in San Diego, CA with over 6 years of
            experience building custom websites, applications, and SaaS integrations for businesses
            of all sizes.
          </p>
          <p>
            At <span class="text-[var(--color-text)] font-medium">Selfbook</span>, I led the onboarding
            engineering function — building JavaScript libraries and plugins that integrated our SaaS
            booking platform into diverse customer websites across different browsers and platforms.
          </p>
          <p>
            Before that, I ran <span class="text-[var(--color-text)] font-medium">Brevity Is</span>,
            a web development firm where I grew the client portfolio 300% year-over-year delivering
            custom full-stack applications and WordPress solutions.
          </p>
          <p>
            I'm also a U.S. Marine Corps veteran and AWS Certified Cloud Practitioner.
          </p>
        </div>
      </div>
      <div class="space-y-4">
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <p class="font-mono text-xs text-[var(--color-accent)] mb-4 tracking-widest uppercase">Quick Facts</p>
          <ul class="space-y-3">
            {[
              ['Location', 'San Diego, California'],
              ['Current Role', 'Onboarding Engineering Manager'],
              ['Company', 'Selfbook'],
              ['Certification', 'AWS Certified Cloud Practitioner'],
              ['Education', 'UC San Diego Extension & SD Mesa College'],
              ['Status', 'Open to new opportunities'],
            ].map(([label, value]) => (
              <li class="flex items-start gap-3">
                <span class="font-mono text-xs text-[var(--color-muted)] w-28 shrink-0 pt-0.5">{label}</span>
                <span class="text-sm text-[var(--color-text)]">{value}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
